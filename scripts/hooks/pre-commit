#!/bin/bash
#
# WatchDoc Pre-commit Hook
# This script verifies that code changes comply with WDP protection rules.
#
# Installation:
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo "⚠️  Python 3 is required for WatchDoc verification"
    exit 0
fi

# Check if .watchdoc directory exists (WatchDoc initialized)
if [ ! -d "$PROJECT_ROOT/.watchdoc" ]; then
    # WatchDoc not initialized, skip verification
    exit 0
fi

# Run WatchDoc pre-commit verification
echo "🔍 Running WatchDoc pre-commit verification..."

python3 -m watchdoc.hooks.pre_commit

exit $?
