# WATCHDOC .gitignore
# This file tells Git which files not to track

# ===================================
# Python
# ===================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===================================
# Virtual Environment
# ===================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ===================================
# IDE and Editors
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===================================
# Testing and Coverage
# ===================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ===================================
# WATCHDOC Specific
# ===================================
.watchdoc/overrides.json
.watchdoc/temporary_grants.yaml
.watchdoc/current_session.yaml
*.skill
*.log
temp/
tmp/

# ===================================
# Node.js (if any JS/TS code)
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===================================
# OS Files
# ===================================
Thumbs.db
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ===================================
# Local Config (contains secrets!)
# ===================================
*.local
*.env.local
*.env.*.local
config.local.json
secrets.json
